' NES / SmileBASIC 4 -- NROM/MMC3, NTSC, approximate four-channel audio
' Source generated with python3 tools/build.py
' ROMFILE$="" uses @ROMHEX DATA, terminated by END.
' Set ROMFILE$="TXT:ROMHEX" only where TXT loading is available.
ROMFILE$=""
DIM ROM[786960],RAM[2048],SRAM[8192],CHR[8192]
DIM NT[4096],PAL[32],OAM[256],COL[64]
DIM OT[256],MT[256],CT[256],PT[256]
DIM BG[256],PIX[256],USED[256]
DIM BANKREG[8],PRGBANK[4],CHRBANK[8],SPR12[8]
DIM APREG[24],APLEN[4],APENV[4],APDIV[4],APSTART[4],APSW[2]
DIM APLTABLE[32],APHANDLE[4],APVOICE[4],APWAVE[256],APNOISE[16]
GOSUB @LOADROM
RESTORE @OPTABLE
FOR I=0 TO 255
 READ OT[I],MT[I],CT[I],PT[I]
NEXT
RESTORE @COLORS
FOR I=0 TO 63
 READ HC$
 COL[I]=VAL("&HFF"+HC$)
NEXT
AC=0:XR=0:YR=0:SP=253:FL=36
GOSUB @RESETVECTOR
CTRL=0:MASK=0:STATUS=0:OA=0:PV=0:PTEMP=0:WT=0:FINE=0:BUFFER=0:BUS=0
SCX=0:SCY=0:SCANV=0:PAD=0:LATCH=0:JOY=0:STROBE=0
DOT=0:LINE=261:CYCLES=0:PPUTIME=0:NMI=0:NMILINE=0:FRAMEPEND=0
GOSUB @APINIT:GOSUB @SOUNDINIT
CLS:GCLS
' Native 256x240 image at top left. + stops via SmileBASIC.
@MAIN
GOSUB @CPU:GOSUB @ADVANCE
IF FRAMEPEND THEN FRAMEPEND=0:GOSUB @INPUT:GOSUB @SOUND:VSYNC 1
GOTO @MAIN

' Instruction-granularity CPU, timed PPU fetch phases for MMC3 A12.
' The renderer is a scanline snapshot and does not clock the mapper itself.
@ADVANCE
GOSUB @APADVANCE
TICKS=CC*3:CYCLES=CYCLES+CC
WHILE TICKS>0
 NEXTDOT=341
 IF DOT<1 THEN NEXTDOT=1
 IF (LINE<240 OR LINE==261) AND DOT>=1 THEN
  ' Low background fetches cannot change A12 once it is already low.
  ' Always retain sprite phases: their banks were latched earlier.
  IF MAPPER==4 AND (MASK AND 24)!=0 AND ((DOT>=257 AND DOT<321) OR (CTRL AND 16)!=0 OR A12HIGH) THEN
   NEXTDOT=((DOT+3) DIV 4)*4+1
  ELSE
   IF DOT<257 THEN NEXTDOT=257
   IF LINE==261 AND (MASK AND 24)!=0 AND DOT>=257 AND DOT<281 THEN NEXTDOT=281
  ENDIF
 ENDIF
 DELTA=NEXTDOT-DOT
 IF TICKS<DELTA THEN
  DOT=DOT+TICKS:PPUTIME=PPUTIME+TICKS:TICKS=0
 ELSE
  DOT=NEXTDOT:PPUTIME=PPUTIME+DELTA:TICKS=TICKS-DELTA:GOSUB @PPUEVENT
 ENDIF
WEND
RETURN
@PPUEVENT
IF DOT==341 THEN
 DOT=0:LINE=LINE+1
 IF LINE>=262 THEN LINE=0
 RETURN
ENDIF
IF DOT==1 THEN
 IF LINE<240 THEN SCANV=PV
 IF LINE==240 THEN FRAMEPEND=1
 IF LINE==241 THEN STATUS=STATUS OR 128:GOSUB @NMICHECK
 IF LINE==261 THEN STATUS=STATUS AND 31:GOSUB @NMICHECK
ENDIF
IF DOT==257 AND LINE<240 THEN GOSUB @DRAWLINE
IF (LINE<240 OR LINE==261) AND (MASK AND 24)!=0 THEN
 IF DOT==257 THEN GOSUB @SCROLLNEXT:PV=(PV AND 31712) OR (PTEMP AND 1055)
 IF LINE==261 AND DOT==281 THEN PV=(PV AND 1055) OR (PTEMP AND 31712)
ENDIF
IF MAPPER!=4 THEN RETURN
IF (LINE>=240 AND LINE!=261) OR (MASK AND 24)==0 THEN RETURN
IF DOT==257 THEN GOSUB @SPRITEFETCH
AV=0
IF DOT<=256 OR (DOT>=321 AND DOT<=336) THEN
 IF (DOT AND 7)==5 THEN AV=256*(CTRL AND 16)
ENDIF
IF DOT>=257 AND DOT<=320 THEN
 IF (DOT AND 7)==5 THEN AV=SPR12[(DOT-257) DIV 8]
ENDIF
AT=PPUTIME:GOSUB @A12
RETURN
@SCROLLNEXT
' Vertical increment at the end of a rendered line (dot 256 approximated by 257).
IF (PV AND 28672)!=28672 THEN PV=PV+4096:RETURN
PV=PV AND 4095:COARSEY=(PV >> 5) AND 31
IF COARSEY==29 THEN
 COARSEY=0:PV=PV XOR 2048
ELSE
 IF COARSEY==31 THEN COARSEY=0 ELSE COARSEY=COARSEY+1
ENDIF
PV=(PV AND 31775) OR (COARSEY << 5)
RETURN

@SPRITEFETCH
' Secondary OAM approximation: the first eight sprites for the NEXT line.
' Missing sprites fetch tile $FF, including its high bank bit in 8x16 mode.
SFHEIGHT=8+8*((CTRL AND 32)!=0):SFC=0
FOR SFI=0 TO 7
 IF SFHEIGHT==16 THEN SPR12[SFI]=4096 ELSE SPR12[SFI]=512*(CTRL AND 8)
NEXT
IF LINE==261 THEN RETURN
FOR SFI=0 TO 63
 SFROW=LINE-OAM[SFI*4]
 IF SFROW<0 OR SFROW>=SFHEIGHT THEN CONTINUE
 IF SFHEIGHT==16 THEN SPR12[SFC]=4096*(OAM[SFI*4+1] AND 1)
 SFC=SFC+1
 IF SFC==8 THEN BREAK
NEXT
RETURN


' APU control clocks use CPU cycles, including OAM DMA stalls.
' Audio output is a host-frame approximation; DMC is not implemented.
@APINIT
APENABLE=0:APMODE=0:APINHIBIT=0:APIRQ=0:APTIME=0:APSTEP=0:APLINEAR=0:APRELOAD=0
RESTORE @APLENGTHS
FOR API=0 TO 31
 READ APLTABLE[API]
NEXT
RESTORE @APNOISEPERIODS
FOR API=0 TO 15
 READ APNOISE[API]
NEXT
FOR API=0 TO 23
 APREG[API]=0
NEXT
FOR API=0 TO 3
 APLEN[API]=0:APENV[API]=0:APDIV[API]=0:APSTART[API]=0
NEXT
APSW[0]=0:APSW[1]=0
RETURN
@APSTATUS
RV=APIRQ*64
FOR API=0 TO 3
 IF APLEN[API]>0 THEN RV=RV OR (1 << API)
NEXT
APIRQ=0
RETURN
@APWRITE
APR=AD-16384
IF APR==21 THEN
 APENABLE=WV AND 15
 FOR API=0 TO 3
  IF (APENABLE AND (1 << API))==0 THEN APLEN[API]=0
 NEXT
 RETURN
ENDIF
IF APR==23 THEN
 APMODE=(WV >> 7) AND 1:APINHIBIT=(WV >> 6) AND 1
 IF APINHIBIT THEN APIRQ=0
 APTIME=0:APSTEP=0
 IF APMODE THEN GOSUB @APQUARTER:GOSUB @APHALF
 RETURN
ENDIF
APREG[APR]=WV
IF APR>15 THEN RETURN
API=APR DIV 4
IF (APR AND 3)==3 THEN
 IF (APENABLE AND (1 << API))!=0 THEN APLEN[API]=APLTABLE[WV >> 3]
 APSTART[API]=1
 IF API==2 THEN APRELOAD=1
ENDIF
IF APR==1 OR APR==5 THEN APSW[API]=0
RETURN
@APADVANCE
' Unequal NTSC quarter-frame intervals, rounded to whole CPU cycles.
APTIME=APTIME+CC
WHILE APTIME>=7456
 APBOUND=7457
 IF APSTEP==1 OR APSTEP==3 THEN APBOUND=7456
 IF APTIME<APBOUND THEN RETURN
 APTIME=APTIME-APBOUND:APSTEP=APSTEP+1
 IF APMODE==0 OR APSTEP!=4 THEN GOSUB @APQUARTER
 IF APSTEP==2 OR (APMODE==0 AND APSTEP==4) OR APSTEP==5 THEN GOSUB @APHALF
 IF APMODE==0 AND APSTEP==4 THEN
  IF APINHIBIT==0 THEN APIRQ=1
  APSTEP=0
 ENDIF
 IF APMODE AND APSTEP==5 THEN APSTEP=0
WEND
RETURN
@APQUARTER
FOR API=0 TO 3
 IF API!=2 THEN
  APC=APREG[API*4]
  IF APSTART[API] THEN
   APSTART[API]=0:APENV[API]=15:APDIV[API]=APC AND 15
  ELSE
   IF APDIV[API]>0 THEN
    APDIV[API]=APDIV[API]-1
   ELSE
    APDIV[API]=APC AND 15
    IF APENV[API]>0 THEN
     APENV[API]=APENV[API]-1
    ELSE
     IF (APC AND 32)!=0 THEN APENV[API]=15
    ENDIF
   ENDIF
  ENDIF
 ENDIF
NEXT
IF APRELOAD THEN
 APLINEAR=APREG[8] AND 127
ELSE
 IF APLINEAR>0 THEN APLINEAR=APLINEAR-1
ENDIF
IF (APREG[8] AND 128)==0 THEN APRELOAD=0
RETURN
@APHALF
FOR API=0 TO 3
 APHALT=32
 IF API==2 THEN APHALT=128
 IF APLEN[API]>0 AND (APREG[API*4] AND APHALT)==0 THEN APLEN[API]=APLEN[API]-1
NEXT
FOR API=0 TO 1
 GOSUB @APTARGET
 IF APSW[API]==0 AND (APREG[API*4+1] AND 128)!=0 AND (APREG[API*4+1] AND 7)!=0 AND APPER>=8 AND APTARGET<=2047 AND APTARGET>=0 THEN
  APREG[API*4+2]=APTARGET AND 255:APREG[API*4+3]=(APREG[API*4+3] AND 248) OR (APTARGET >> 8)
 ENDIF
 IF APSW[API]==0 THEN APSW[API]=(APREG[API*4+1] >> 4) AND 7 ELSE APSW[API]=APSW[API]-1
NEXT
RETURN
@APTARGET
APPER=APREG[API*4+2]+256*(APREG[API*4+3] AND 7)
APSHIFT=APREG[API*4+1] AND 7:APCHANGE=APPER >> APSHIFT
APTARGET=APPER+APCHANGE
IF (APREG[API*4+1] AND 8)!=0 THEN APTARGET=APPER-APCHANGE-(API==0)
RETURN

' Looping BEEP voices use signed 16-bit WAVSETA data at 44 kHz.
' A 100-sample cycle is A440, so pitch is relative to MIDI note 69.
@SOUNDINIT
SNDSTOP
FOR API=0 TO 4
 FOR APJ=0 TO 255
  APWAVE[APJ]=0
  IF APJ<100 THEN
   IF API<4 THEN
    APDUTY=12.5
    IF API==1 THEN APDUTY=25
    IF API==2 THEN APDUTY=50
    IF API==3 THEN APDUTY=75
    IF APJ<APDUTY THEN APWAVE[APJ]=8192 ELSE APWAVE[APJ]=-8192
   ELSE
    APWAVE[APJ]=8192-327.68*ABS(APJ-50)
   ENDIF
  ENDIF
 NEXT
 WAVSETA 224+API,127,127,127,127,APWAVE,69,0,99,44000,0,1
NEXT
APSEED=1
FOR APJ=0 TO 255
 APBIT=(APSEED XOR (APSEED >> 1)) AND 1:APSEED=(APSEED >> 1) OR (APBIT << 14)
 APWAVE[APJ]=8192
 IF (APSEED AND 1)!=0 THEN APWAVE[APJ]=-8192
NEXT
WAVSETA 229,127,127,127,127,APWAVE,69,0,255,44000,0,1
FOR API=0 TO 3
 APVOICE[API]=-1:APHANDLE[API]=-1
NEXT
RETURN
@SOUND
FOR API=0 TO 3
 APVOL=0:APINST=228:APFREQ=440
 IF APLEN[API]>0 THEN
  APC=APREG[API*4]
  IF API==2 THEN
   IF APLINEAR>0 THEN APVOL=48
   APPER=APREG[10]+256*(APREG[11] AND 7)
   APFREQ=1789773/(32*(APPER+1))
   IF APPER<2 THEN APVOL=0
  ELSE
   APVOL=APENV[API]*4
   IF (APC AND 16)!=0 THEN APVOL=(APC AND 15)*4
   IF API<2 THEN
    GOSUB @APTARGET:APINST=224+(APC >> 6)
    APFREQ=1789773/(16*(APPER+1))
    IF APPER<8 OR APTARGET>2047 THEN APVOL=0
   ELSE
    APINST=229:APFREQ=440*1789773/(44000*APNOISE[APREG[14] AND 15])
   ENDIF
  ENDIF
 ENDIF
 IF APVOICE[API]!=APINST THEN
  IF APHANDLE[API]>=0 THEN BEEPSTOP APHANDLE[API]
  APHANDLE[API]=BEEP(APINST,0,0):APVOICE[API]=APINST
 ENDIF
 APPITCH=1200*LOG(APFREQ/440)/LOG(2)
 APPITCH=MAX(-32768,MIN(32767,APPITCH))
 BEEPPIT APHANDLE[API],APPITCH
 BEEPVOL APHANDLE[API],APVOL
NEXT
RETURN
@APLENGTHS
DATA 10,254,20,2,40,4,80,6,160,8,60,10,14,12,26,14
DATA 12,16,24,18,48,20,96,22,192,24,72,26,16,28,32,30
@APNOISEPERIODS
DATA 4,8,16,32,64,96,128,160,202,254,380,508,762,1016,2034,4068

@LOADROM
N=0:HI=-1
IF ROMFILE$!="" THEN TEXT$=LOADV(ROMFILE$):GOSUB @HEXSTRING ELSE GOSUB @HEXDATAS
IF HI!=-1 THEN PRINT "ODD HEX DIGIT COUNT":END
GOSUB @VALIDATE:GOSUB @CARTINIT
RETURN
@VALIDATE
IF N<16 THEN PRINT "MISSING INES HEADER":END
IF ROM[0]!=78 OR ROM[1]!=69 OR ROM[2]!=83 OR ROM[3]!=26 THEN PRINT "NOT INES":END
IF (ROM[7] AND 12)==8 THEN PRINT "NES 2.0 NOT SUPPORTED":END
MAPPER=(ROM[6] >> 4) OR (ROM[7] AND 240)
IF MAPPER!=0 AND MAPPER!=4 THEN PRINT "UNSUPPORTED MAPPER ";MAPPER:END
IF (ROM[7] AND 3)!=0 THEN PRINT "ONLY STANDARD NES":END
IF MAPPER==0 THEN
 IF ROM[4]<1 OR ROM[4]>2 OR ROM[5]>1 THEN PRINT "BAD NROM SIZE":END
ELSE
 IF ROM[4]<2 OR ROM[4]>32 OR ROM[5]>32 THEN PRINT "BAD MMC3 SIZE":END
 IF (ROM[4] AND (ROM[4]-1))!=0 OR (ROM[5] AND (ROM[5]-1))!=0 THEN PRINT "MMC3 SIZE MUST BE POWER OF TWO":END
ENDIF
IF ROM[8]>1 THEN PRINT "ONLY 8K PRG RAM SUPPORTED":END
PRGS=ROM[4]*16384:CHRS=ROM[5]*8192
PRGO=16+512*((ROM[6] AND 4)!=0):CHRO=PRGO+PRGS
IF N!=CHRO+CHRS THEN PRINT "ROM LENGTH MISMATCH":END
MIRROR=ROM[6] AND 1:FOUR=(ROM[6] AND 8)!=0
IF (ROM[9] AND 1)!=0 THEN PRINT "PAL ROM NOT SUPPORTED":END
RETURN
@CARTINIT
PRGCOUNT=PRGS DIV 8192:CHRCOUNT=CHRS DIV 1024
IF CHRS==0 THEN CHRCOUNT=8
BANKSEL=0:RAMCTRL=128:IRQLATCH=0:IRQCOUNT=0:IRQRELOAD=0:IRQENABLE=0:MIRQ=0
A12HIGH=0:A12LOW=-8
BANKREG[0]=0:BANKREG[1]=2:BANKREG[2]=4:BANKREG[3]=5
BANKREG[4]=6:BANKREG[5]=7:BANKREG[6]=0:BANKREG[7]=1
GOSUB @BANKUPDATE
IF PRGO==528 THEN
 FOR I=0 TO 511
  SRAM[4096+I]=ROM[16+I]
 NEXT
ENDIF
RETURN
@RESETVECTOR
AD=65532:GOSUB @READ:LO=RV:AD=65533:GOSUB @READ:PC=LO+256*RV
RETURN
@BANKUPDATE
IF MAPPER==0 THEN
 FOR BI=0 TO 7
  CHRBANK[BI]=BI*1024
 NEXT
 RETURN
ENDIF
PRGBANK[0]=8192*((BANKREG[6] AND 63) MOD PRGCOUNT)
PRGBANK[1]=8192*((BANKREG[7] AND 63) MOD PRGCOUNT)
PRGBANK[2]=PRGS-16384:PRGBANK[3]=PRGS-8192
IF (BANKSEL AND 64)!=0 THEN BSAVE=PRGBANK[0]:PRGBANK[0]=PRGBANK[2]:PRGBANK[2]=BSAVE
CHRXOR=0
IF (BANKSEL AND 128)!=0 THEN CHRXOR=4
CHRBANK[0 XOR CHRXOR]=1024*((BANKREG[0] AND 254) MOD CHRCOUNT)
CHRBANK[1 XOR CHRXOR]=1024*(((BANKREG[0] AND 254)+1) MOD CHRCOUNT)
CHRBANK[2 XOR CHRXOR]=1024*((BANKREG[1] AND 254) MOD CHRCOUNT)
CHRBANK[3 XOR CHRXOR]=1024*(((BANKREG[1] AND 254)+1) MOD CHRCOUNT)
FOR BI=4 TO 7
 CHRBANK[BI XOR CHRXOR]=1024*(BANKREG[BI-2] MOD CHRCOUNT)
NEXT
RETURN
@MAPPERWRITE
MR=AD AND 57345
IF MR==32768 THEN BANKSEL=WV:GOSUB @BANKUPDATE:RETURN
IF MR==32769 THEN BANKREG[BANKSEL AND 7]=WV:GOSUB @BANKUPDATE:RETURN
IF MR==40960 THEN
 IF FOUR==0 THEN MIRROR=1-(WV AND 1)
 RETURN
ENDIF
IF MR==40961 THEN RAMCTRL=WV:RETURN
IF MR==49152 THEN IRQLATCH=WV:RETURN
IF MR==49153 THEN IRQRELOAD=1:RETURN
IF MR==57344 THEN IRQENABLE=0:MIRQ=0:RETURN
IF MR==57345 THEN IRQENABLE=1
RETURN
@A12
' AV = PPU bus A12, AT = absolute PPU dot timestamp.
' Clock only a rising edge preceded by at least eight low PPU dots.
IF AV==0 THEN
 IF A12HIGH THEN A12LOW=AT
 A12HIGH=0:RETURN
ENDIF
IF A12HIGH==0 AND AT-A12LOW>=8 THEN GOSUB @IRQCLOCK
A12HIGH=1
RETURN
@IRQCLOCK
' MMC3B/C: a zero reload value can assert IRQ on every qualified edge.
IF IRQCOUNT==0 OR IRQRELOAD THEN IRQCOUNT=IRQLATCH:IRQRELOAD=0 ELSE IRQCOUNT=IRQCOUNT-1
IF IRQCOUNT==0 AND IRQENABLE THEN MIRQ=1
RETURN
@CPUA12
IF MAPPER!=4 THEN RETURN
' During rendering the fetch scheduler owns A12; $2006 rendering races omitted.
IF (LINE<240 OR LINE==261) AND (MASK AND 24)!=0 THEN RETURN
AV=PV AND 4096:AT=PPUTIME:GOSUB @A12
RETURN

@HEXDATAS
RESTORE @ROMHEX
REPEAT
 READ TEXT$
 IF TEXT$!="END" THEN GOSUB @HEXSTRING
UNTIL TEXT$=="END"
RETURN
@HEXSTRING
FOR HX=0 TO LEN(TEXT$)-1
 CH$=MID$(TEXT$,HX,1):HV=ASC(CH$)
 IF HV==9 OR HV==10 OR HV==13 OR HV==32 THEN CONTINUE
 IF HV>=48 AND HV<=57 THEN
  HV=HV-48
 ELSE
  IF HV>=65 AND HV<=70 THEN
   HV=HV-55
  ELSE
   IF HV>=97 AND HV<=102 THEN
    HV=HV-87
   ELSE
    PRINT "INVALID HEX CHARACTER":END
   ENDIF
  ENDIF
 ENDIF
 IF HI<0 THEN
  HI=HV
 ELSE
  IF N>=786960 THEN PRINT "ROM TOO LARGE":END
  ROM[N]=HI*16+HV:N=N+1:HI=-1
 ENDIF
NEXT
RETURN

' Bus interface: AD address, RV read result, WV write data.
@READ
AD=AD AND 65535
IF AD<8192 THEN RV=RAM[AD AND 2047]:RETURN
IF AD<16384 THEN
 RG=AD AND 7:RV=BUS
 IF RG==2 THEN RV=(STATUS AND 224) OR (BUS AND 31):STATUS=STATUS AND 127:WT=0:GOSUB @NMICHECK
 IF RG==4 THEN RV=OAM[OA]
 IF RG==7 THEN
  GOSUB @CPUA12:PA=PV AND 16383:GOSUB @PREAD:RV=BUFFER:BUFFER=PB
  IF PA>=16128 THEN
   RV=PB:PA=(PA-4096) AND 16383:GOSUB @PREAD:BUFFER=PB
  ENDIF
  PV=(PV+1+31*((CTRL AND 4)!=0)) AND 32767:GOSUB @CPUA12
 ENDIF
 BUS=RV:RETURN
ENDIF
IF AD==16405 THEN GOSUB @APSTATUS:RETURN
IF AD==16406 THEN
 IF STROBE THEN
  RV=PAD AND 1
 ELSE
  IF JOY<8 THEN RV=(LATCH >> JOY) AND 1 ELSE RV=1
  JOY=JOY+1
 ENDIF
 RV=RV OR 64:RETURN
ENDIF
IF AD==16407 THEN RV=64:RETURN
IF AD<24576 THEN RV=0:RETURN
IF AD<32768 THEN
 RV=0
 IF MAPPER==0 OR (RAMCTRL AND 128)!=0 THEN RV=SRAM[AD-24576]
 RETURN
ENDIF
IF MAPPER==4 THEN RV=ROM[PRGO+PRGBANK[(AD-32768) DIV 8192]+(AD AND 8191)]:RETURN
RV=ROM[PRGO+((AD-32768) MOD PRGS)]
RETURN
@WRITE
AD=AD AND 65535:WV=WV AND 255
IF AD<8192 THEN RAM[AD AND 2047]=WV:RETURN
IF AD<16384 THEN
 RG=AD AND 7:BUS=WV
 IF RG==0 THEN CTRL=WV:PTEMP=(PTEMP AND 29695) OR ((WV AND 3)<<10):GOSUB @NMICHECK
 IF RG==1 THEN MASK=WV
 IF RG==3 THEN OA=WV
 IF RG==4 THEN OAM[OA]=WV:OA=(OA+1) AND 255
 IF RG==5 THEN
  IF WT==0 THEN SCX=WV:FINE=WV AND 7:PTEMP=(PTEMP AND 32736) OR (WV >> 3) ELSE SCY=WV:PTEMP=(PTEMP AND 3103) OR ((WV AND 248)<<2) OR ((WV AND 7)<<12)
  WT=1-WT
 ENDIF
 IF RG==6 THEN
  IF WT==0 THEN PTEMP=(PTEMP AND 255) OR ((WV AND 63)<<8) ELSE PTEMP=(PTEMP AND 32512) OR WV:PV=PTEMP
  WT=1-WT
  IF WT==0 THEN GOSUB @CPUA12
 ENDIF
 IF RG==7 THEN GOSUB @CPUA12:PA=PV AND 16383:PB=WV:GOSUB @PWRITE:PV=(PV+1+31*((CTRL AND 4)!=0)) AND 32767:GOSUB @CPUA12
 RETURN
ENDIF
IF (AD>=16384 AND AD<=16403) OR AD==16405 OR AD==16407 THEN GOSUB @APWRITE:RETURN
IF AD==16404 THEN
 DMA=WV*256
 FOR DI=0 TO 255
  AD=DMA+DI:GOSUB @READ:OAM[(OA+DI) AND 255]=RV
 NEXT
 CC=CC+513+(CYCLES AND 1):RETURN
ENDIF
IF AD==16406 THEN
 IF (WV AND 1)!=0 OR STROBE!=0 THEN LATCH=PAD:JOY=0
 STROBE=WV AND 1:RETURN
ENDIF
IF AD>=32768 THEN
 IF MAPPER==4 THEN GOSUB @MAPPERWRITE
 RETURN
ENDIF
IF AD>=24576 THEN
 IF MAPPER==0 OR (RAMCTRL AND 192)==128 THEN SRAM[AD-24576]=WV
ENDIF
RETURN
@PMAP
PA=PA AND 16383
IF PA<8192 THEN RETURN
IF PA<16128 THEN
 PA=(PA-8192) AND 4095:PN=PA >> 10
 IF FOUR==0 THEN
  IF MIRROR THEN PN=PN AND 1 ELSE PN=PN >> 1
 ENDIF
 PA=8192+PN*1024+(PA AND 1023):RETURN
ENDIF
PA=PA AND 31
IF (PA AND 19)==16 THEN PA=PA-16
PA=16128+PA
RETURN
@PREAD
GOSUB @PMAP
IF PA<8192 THEN
 CI=CHRBANK[PA DIV 1024]+(PA AND 1023)
 IF CHRS==0 THEN PB=CHR[CI] ELSE PB=ROM[CHRO+CI]
 RETURN
ENDIF
IF PA<16128 THEN PB=NT[PA-8192]:RETURN
PB=PAL[PA-16128]
RETURN
@PWRITE
GOSUB @PMAP
IF PA<8192 THEN
 IF CHRS==0 THEN CHR[CHRBANK[PA DIV 1024]+(PA AND 1023)]=PB
 RETURN
ENDIF
IF PA<16128 THEN NT[PA-8192]=PB:RETURN
PAL[PA-16128]=PB AND 63
RETURN
@PATTERNROW
CI=CHRBANK[CA DIV 1024]+(CA AND 1023)
IF CHRS==0 THEN PL0=CHR[CI]:PL1=CHR[CI+8] ELSE PL0=ROM[CHRO+CI]:PL1=ROM[CHRO+CI+8]
RETURN

@NMICHECK
NL=((STATUS AND 128)!=0) AND ((CTRL AND 128)!=0)
IF NL AND NMILINE==0 THEN NMI=1
NMILINE=NL
RETURN

@CPU
CC=0
IF NMI THEN
 NMI=0:PS=PC >> 8:GOSUB @PUSH:PS=PC AND 255:GOSUB @PUSH
 PS=(FL OR 32) AND 239:GOSUB @PUSH:FL=FL OR 4
 AD=65530:GOSUB @READ:LO=RV:AD=65531:GOSUB @READ:PC=LO+256*RV
 CC=7:RETURN
ENDIF
IF (MIRQ OR APIRQ) AND (FL AND 4)==0 THEN
 PS=PC >> 8:GOSUB @PUSH:PS=PC AND 255:GOSUB @PUSH
 PS=(FL OR 32) AND 239:GOSUB @PUSH:FL=FL OR 4
 AD=65534:GOSUB @READ:LO=RV:AD=65535:GOSUB @READ:PC=LO+256*RV
 CC=7:RETURN
ENDIF
GOSUB @FETCH:OP=RV:K=OT[OP]:MD=MT[OP]:CC=CT[OP]
IF K==0 THEN PRINT "UNSUPPORTED OPCODE ";HEX$(OP);" AT ";HEX$((PC-1) AND 65535):END
CROSS=0:GOSUB @ADDRESS
CC=CC+CROSS*PT[OP]
IF K<29 THEN
IF K<15 THEN
IF K<8 THEN
IF K<4 THEN
IF K<2 THEN
GOSUB @O_ADC:RETURN
ELSE
IF K<3 THEN
GOSUB @O_AND:RETURN
ELSE
GOSUB @O_ASL:RETURN
ENDIF
ENDIF
ELSE
IF K<6 THEN
IF K<5 THEN
GOSUB @O_BCC:RETURN
ELSE
GOSUB @O_BCS:RETURN
ENDIF
ELSE
IF K<7 THEN
GOSUB @O_BEQ:RETURN
ELSE
GOSUB @O_BIT:RETURN
ENDIF
ENDIF
ENDIF
ELSE
IF K<11 THEN
IF K<9 THEN
GOSUB @O_BMI:RETURN
ELSE
IF K<10 THEN
GOSUB @O_BNE:RETURN
ELSE
GOSUB @O_BPL:RETURN
ENDIF
ENDIF
ELSE
IF K<13 THEN
IF K<12 THEN
GOSUB @O_BRK:RETURN
ELSE
GOSUB @O_BVC:RETURN
ENDIF
ELSE
IF K<14 THEN
GOSUB @O_BVS:RETURN
ELSE
GOSUB @O_CLC:RETURN
ENDIF
