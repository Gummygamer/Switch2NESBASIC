' Scanline snapshot renderer, using the internal v/t scrolling state.
@DRAWLINE
FOR SX=0 TO 255
 BG[SX]=0:PIX[SX]=PAL[0]:USED[SX]=0
NEXT
IF (MASK AND 8)!=0 THEN
 BGOFF=FINE+8*(SCANV AND 31):BGNX=(SCANV >> 10) AND 1:BGNY=(SCANV >> 11) AND 1
 BGTY=(SCANV >> 5) AND 31:BGROW=BGTY*32
 BGATTR=960+(BGTY DIV 4)*8:BGSHIFT=4*((BGTY DIV 2) MOD 2)
 BGPAT=256*(CTRL AND 16)+((SCANV >> 12) AND 7)
 BGSTART=0
 IF (MASK AND 2)==0 THEN BGSTART=8
 FOR SX=BGSTART TO 255
  WX=SX+BGOFF
  ' Fetch once per tile span, including a clipped or fine-scrolled first span.
  IF SX==BGSTART OR (WX AND 7)==0 THEN
   NX=BGNX XOR ((WX DIV 256) AND 1):PN=NX+2*BGNY
   IF FOUR==0 THEN
    IF MIRROR THEN PN=PN AND 1 ELSE PN=PN >> 1
   ENDIF
   BGBASE=PN*1024:TX=(WX AND 255) DIV 8
   TILE=NT[BGBASE+BGROW+TX]
   ATTR=(NT[BGBASE+BGATTR+(TX DIV 4)] >> (2*((TX DIV 2) MOD 2)+BGSHIFT)) AND 3
   BGPAL=ATTR*4:CA=BGPAT+TILE*16
   GOSUB @PATTERNROW
  ENDIF
  BITN=7-(WX AND 7):COLOR=((PL0 >> BITN) AND 1)+2*((PL1 >> BITN) AND 1)
  IF COLOR!=0 THEN BG[SX]=COLOR:PIX[SX]=PAL[BGPAL+COLOR]
 NEXT
ENDIF
IF (MASK AND 16)!=0 THEN
 COUNT=0:HEIGHT=8+8*((CTRL AND 32)!=0)
 FOR SI=0 TO 63
  SY=OAM[SI*4]+1:ROW=LINE-SY
  IF ROW<0 OR ROW>=HEIGHT THEN CONTINUE
  COUNT=COUNT+1
  IF COUNT>8 THEN STATUS=STATUS OR 32:BREAK
  TILE=OAM[SI*4+1]:ATTR=OAM[SI*4+2]:SX0=OAM[SI*4+3]
  IF (ATTR AND 128)!=0 THEN ROW=HEIGHT-1-ROW
  IF HEIGHT==16 THEN CA=(TILE AND 1)*4096+(TILE AND 254)*16+(ROW DIV 8)*16+(ROW AND 7) ELSE CA=4096*((CTRL AND 8)!=0)+TILE*16+ROW
  GOSUB @PATTERNROW
  FOR DX=0 TO 7
   SX=SX0+DX
   IF SX>255 THEN CONTINUE
   IF SX<8 AND (MASK AND 4)==0 THEN CONTINUE
   BITN=7-DX
   IF (ATTR AND 64)!=0 THEN BITN=DX
   COLOR=((PL0 >> BITN) AND 1)+2*((PL1 >> BITN) AND 1)
   IF COLOR==0 THEN CONTINUE
   IF SI==0 AND SX<255 AND BG[SX]!=0 THEN STATUS=STATUS OR 64
   IF USED[SX]!=0 THEN CONTINUE
   USED[SX]=1
   IF (ATTR AND 32)==0 OR BG[SX]==0 THEN PIX[SX]=PAL[16+(ATTR AND 3)*4+COLOR]
  NEXT
 NEXT
ENDIF
COLMASK=63
IF (MASK AND 1)!=0 THEN COLMASK=48
FOR SX=0 TO 255
 PIX[SX]=PIX[SX] AND COLMASK
NEXT
GLOAD 0,LINE,256,1,PIX,COL,0
RETURN
